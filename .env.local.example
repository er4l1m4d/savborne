# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real keys.

# Supabase (find in Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Player sessions (REQUIRED in production).
# At least 32 bytes. Generate with: openssl rand -base64 48
# Changing it invalidates every outstanding 12-hour session.
SESSION_SECRET=generate-a-unique-32-byte-or-longer-secret

# Daily vault snapshot cron (REQUIRED when the cron route is deployed).
# Vercel sends it automatically as `Authorization: Bearer $CRON_SECRET`.
# Generate with: openssl rand -hex 32
CRON_SECRET=generate-a-unique-cron-secret

# Nimiq network hint (optional; app auto-detects via getHostNetwork())
# NEXT_PUBLIC_NIMIQ_NETWORK=mainnet

# Nimiq RPC endpoints (optional; comma-separated, tried in order).
# The default is https://rpc.nimiqwatch.com
# NIMIQ_RPC_URLS=https://rpc.nimiqwatch.com,https://rpc.nimiq.watch

# Error reporting (optional; no DSN means structured server logs only).
# SENTRY_DSN=
